{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    // lets tsdown emit .d.ts with Oxc, because TS 7 has no compiler API for it to use
    "declaration": true,
    "isolatedDeclarations": true,
    "types": ["node"]
  },
  "include": ["src"]
}
